{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "mcp_events": true
  },
  "mcp": {
    "servers": {
      "inbox-preview": {
        "type": "remote",
        "url": "https://preview-inbox.holdenitdown.net/mcp",
        "protocol": "2026-07-28"
      },
      "inbox": {
        "type": "remote",
        "url": "http://localhost:8080/mcp",
        "protocol": "2026-07-28",
        "oauth": false
      }
    }
  }
}
