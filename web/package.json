{
  "name": "inbox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --config playwright.offline.config.ts",
    "e2e:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@grafana/faro-web-sdk": "^2.0.0",
    "@grafana/faro-web-tracing": "^2.0.0",
    "@opentelemetry/api": "1.9.0",
    "@tanstack/solid-query": "^5.90.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.0"
  }
}
