# Run python3 scripts/setup.py instead of copying these placeholders.
POSTGRES_PASSWORD=generated-by-setup
AWS_ACCESS_KEY_ID=generated-by-setup
AWS_SECRET_ACCESS_KEY=generated-by-setup
INBOX_HTTP_PORT=8080
INBOX_SMTP_PORT=2525
INBOX_DOMAIN=inbox.test
INBOX_S3_BUCKET=inbox
# Compose supplies this private service address directly.
INBOX_NATS_URL=nats://nats:4222
INBOX_AUTH_MODE=disabled
INBOX_NATS_NAMESPACE=INBOX
INBOX_NATS_REPLICAS=1
# Optional outside private Compose: paired INBOX_NATS_USER and INBOX_NATS_PASSWORD,
# or INBOX_NATS_CREDENTIALS_FILE, never both. OIDC requires explicit namespace/replicas.
INBOX_ENVIRONMENT=compose
INBOX_FARO_URL=https://faro.holdenitdown.net/collect
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.holdenitdown.net:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
